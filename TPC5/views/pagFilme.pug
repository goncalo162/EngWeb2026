extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
        h1 #{filme.title}

    .w3-container
        h2 Ano de Estreia: #{filme.year}
        h3 Id: #{filme.id}
        h3 Elenco:
        ul
        for ator in elenco
            li.w3-margin-left #{ator.nome}

        h3 Géneros:
        ul
        for genero in generos
            li.w3-margin-left #{genero.nome}

        a.w3-btn.w3-margin-top.w3-margin-left.w3-margin-bottom.w3-round.w3-red(href="/filmes") Voltar