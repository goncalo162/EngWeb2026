extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Géneros

    .w3-container
        table.w3-table-all.w3-margin-top
            tr
              th Nome
              th Número de Filmes
              th Id

            each g in list
                tr.w3-hover-teal.clickable-row(onclick=`window.location='/generos/${g.id}'`)
                    td= g.nome
                    td= g.filmes.length
                    td= g.id

    include voltar