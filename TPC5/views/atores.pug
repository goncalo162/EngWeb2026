extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Atores

    .w3-container
        table.w3-table-all.w3-margin-top
            tr
              th Nome
              th Número de Filmes
              th Id

            each a in list
                tr.w3-hover-teal.clickable-row(onclick=`window.location='/atores/${a.id}'`)
                    td= a.nome
                    td= a.filmes.length
                    td= a.id

    include voltar