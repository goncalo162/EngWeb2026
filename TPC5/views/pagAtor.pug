extends layout
block content

  .w3-card-4
    header.w3-container.w3-teal
      h1 #{ator.nome}

    .w3-container
      h3 Id: #{ator.id}
      h3 Número de Filmes: #{ator.filmes.length}
      h3 Filmes:
      ul
        for filme in ator.filmes
          li.w3-margin-left #{filme.title}

      a.w3-btn.w3-margin-top.w3-margin-left.w3-margin-bottom.w3-round.w3-red(href="/atores") Voltar