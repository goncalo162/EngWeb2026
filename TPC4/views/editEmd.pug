extends layout
block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Editar Exame Médico Desportivo de #{athlete.nome.primeiro} #{athlete.nome.último}
    form(action=`/emd/${athlete.id}` method="post")
      .w3-container
        .w3-row
          .w3-half.w3-padding-small
            label Primeiro Nome
            input.w3-input(type="text" name="prim_nome" value=athlete.nome.primeiro required)
          .w3-half.w3-padding-small
            label Último Nome
            input.w3-input(type="text" name="ult_nome" value=athlete.nome.último required)

        .w3-row.w3-margin-top
          .w3-half
            p Género
            label.w3-margin-right
              input(type="radio" name="genero" value="F" checked=athlete.género === 'F')
              |  F
            label
              input(type="radio" name="genero" value="M" checked=athlete.género === 'M')
              |  M
          .w3-half
            label Data EMD
            .w3-row
              .w3-third
                select.w3-select.w3-margin-right(name="dia")
                  each dia in Array.from({length: 31}, (_, i) => i + 1)
                    option(value=dia selected=athlete.dataEMD.split('-')[2] == dia)= dia
              .w3-third
                select.w3-select.w3-margin-right(name="mes")
                  each mes, i in ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro']
                    option(value=i+1 selected=athlete.dataEMD.split('-')[1] == i+1)= mes
              .w3-third
                select.w3-select(name="ano")
                  each ano in Array.from({length: 10}, (_, i) => 2024 - i)
                    option(value=ano selected=athlete.dataEMD.split('-')[0] == ano)= ano

        .w3-row.w3-margin-top
          .w3-third.w3-padding-small
            label Morada
            input.w3-input(type="text" name="morada" value=athlete.morada required)
          .w3-third.w3-padding-small
            label Clube
            input.w3-input(type="text" name="clube" value=athlete.clube required)
          .w3-third.w3-padding-small
            label Modalidade
            input.w3-input(type="text" name="modalidade" value=athlete.modalidade required)

        .w3-row.w3-margin-top
          .w3-half.w3-padding-small
            label Email
            input.w3-input(type="text" name="email" value=athlete.email required)
          .w3-half.w3-padding-small
            label Idade
            input.w3-input(type="number" name="idade" value=athlete.idade required)

        .w3-row.w3-margin-top
          .w3-half
            label
              input(type="checkbox" name="federado" value="true" checked=athlete.federado)
              |  Federado
          .w3-half
            label
              input(type="checkbox" name="resultado" value="true" checked=athlete.resultado)
              |  Resultado

        .w3-row.w3-margin-top
          button.w3-btn.w3-round.w3-teal.w3-margin-right(type="submit") Guardar
          include voltar