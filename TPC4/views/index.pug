extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Exames Médicos Desportivos 
        a.w3-btn.w3-round.w3-grey(href="/emd/registo") +
        a.w3-btn.w3-round.w3-grey.w3-margin-left(href="/emd/byname") Nome ▼ 
        a.w3-btn.w3-round.w3-grey.w3-margin-left(href="/emd") Data ▼
        a.w3-btn.w3-round.w3-grey.w3-margin-left(href="/emd/desDate") Data ▲
        a.w3-btn.w3-round.w3-grey.w3-margin-left(href="/emd/stats") Estatísticas

    .w3-container
      table.w3-table-all.w3-margin-top
            tr
              th Nome
              th Data
              th Modalidade
              th Resultado
              th Operações

            each e in list
                tr.w3-hover-teal.clickable-row(onclick=`window.location='/emd/${e.id}'`)
                    td= e.nome.primeiro + " " + e.nome.último
                    td= e.dataEMD
                    td= e.modalidade
                    td= e.resultado
                    td
                      a.w3-btn.w3-round.w3-blue(href=`/emd/editar/${e.id}`) Editar 
                      a.w3-btn.w3-round.w3-red.w3-margin-left(href=`/emd/apagar/${e.id}`) Apagar 